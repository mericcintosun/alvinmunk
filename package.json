{
  "name": "alvinmunk",
  "version": "0.1.0",
  "private": true,
  "description": "alvinmunk — Stellar Passport: a social proof-of-people reputation game on Stellar/Soroban",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contracts:build": "cd contracts && stellar contract build",
    "contracts:test": "cd contracts && cargo test",
    "contracts:fmt": "cd contracts && cargo fmt",
    "contracts:fmt:check": "cd contracts && cargo fmt --all -- --check",
    "contracts:lint": "cd contracts && cargo clippy --all-targets -- -D warnings",
    "check": "pnpm run contracts:fmt:check && pnpm run contracts:lint && pnpm run contracts:test && pnpm run typecheck && pnpm run lint && pnpm run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "playwright": "^1.61.0",
    "prettier": "^3.3.3",
    "turbo": "^2.0.9",
    "typescript": "^5.5.4"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.18.0"
    }
  }
}
