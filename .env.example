# ──────────────────────────────────────────────────────────────
# Stellar Passport — environment template. Copy to apps/web/.env.local
# NEVER commit the real .env.local (see .gitignore). See 00-strategy §4/§7.
# ──────────────────────────────────────────────────────────────

# --- Public site URL (metadataBase → absolute og:image/canonical URLs, robots.txt, sitemap) ---
# Leave empty locally (→ http://localhost:3000) and usually on Vercel too: a production
# build uses the project's production domain (VERCEL_PROJECT_PRODUCTION_URL, custom domain
# included) and a preview its own host (VERCEL_URL). Set it when hosting outside Vercel or
# to pin another canonical host, e.g. https://example.com; on Vercel scope it to Production
# only, or previews will point at the production host.
NEXT_PUBLIC_SITE_URL=

# --- Network (testnet by default; switch to mainnet at Black belt) ---
# Switch these four together. A mix (a mainnet passphrase with a testnet RPC, a missing mainnet
# contract id, ...) is refused: /api/health returns 503 listing each problem, the app shows a
# banner and hands out no wallet, and the attester and faucet answer 503.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
# NEXT_PUBLIC_NETWORK_PASSPHRASE is optional: unset (or blank), it is derived from
# NEXT_PUBLIC_STELLAR_NETWORK. If you set it, it must match that network, or the app
# reports the mismatch (banner, /api/health, 503s) and signs nothing:
#   testnet → "Test SDF Network ; September 2015"
#   mainnet → "Public Global Stellar Network ; September 2015"
# On mainnet NEXT_PUBLIC_RPC_URL has no default (there is no keyless public mainnet RPC) —
# set it; Horizon defaults to https://horizon.stellar.org.
# NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# --- Deployed contract IDs (fill after `stellar contract deploy`) ---
NEXT_PUBLIC_REPUTATION_CONTRACT_ID=
NEXT_PUBLIC_QUEST_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_REWARDS_CONTRACT_ID=
# On-chain username/handle registry (handle ↔ address; powers public /u/<handle>).
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=
# Reputation-gating (Earned/Social XP → access). Composable: any app can check(addr, gate).
NEXT_PUBLIC_GATE_CONTRACT_ID=
# Quest ids, one per evidence type. The dashboard quest buttons target them, and /api/attest
# binds each id to exactly its evidence type: a request whose evidence.type isn't the one
# configured for its questId, or whose questId isn't configured at all, gets 422 and no
# signature. Must be quests the attester is allowlisted for (see scripts/redeploy-all.sh).
# Unset or empty -> the default shown.
#   NEXT_PUBLIC_DEFAULT_QUEST_ID   referral_tx      ("Verify a quest": refer an active wallet)
#   NEXT_PUBLIC_INVITE_QUEST_ID    invite_converts  (someone you invited got vouched for)
#   NEXT_PUBLIC_VOUCHBACK_QUEST_ID vouch_back       (you've vouched for 3+ people)
NEXT_PUBLIC_DEFAULT_QUEST_ID=2
NEXT_PUBLIC_INVITE_QUEST_ID=3
NEXT_PUBLIC_VOUCHBACK_QUEST_ID=4

# --- USDC SAC (testnet placeholder; use canonical Circle SAC on mainnet) ---
NEXT_PUBLIC_USDC_SAC_ID=

# --- Passkey smart-wallet infra (passkey-kit). Set the wallet WASM hash to OFFER passkey
#     onboarding; otherwise the app falls back to a testnet dev wallet (Friendbot). The
#     relayer URL + key are SERVER-only (used in /api/passkey-send) and sponsor fees so the
#     user needs no XLM. Generate a free testnet key: curl https://channels.openzeppelin.com/testnet/gen
#     Runbook: docs/PASSKEY_HANDOFF.md. ---
NEXT_PUBLIC_PASSKEY_WALLET_WASM_HASH=
PASSKEY_RELAYER_URL=https://channels.openzeppelin.com/testnet
PASSKEY_RELAYER_API_KEY=

# --- Fee sponsorship (paymaster). Public key shown client-side; secret stays server-only ---
NEXT_PUBLIC_SPONSOR_PUBLIC_KEY=
SPONSOR_SECRET_KEY=

# --- Attester (SERVER-ONLY, used by /api/attest serverless route). Allowlisted on-chain ---
# Generate with: stellar keys generate attester  (then add its public key via add_attester)
ATTESTER_SECRET_KEY=

# --- GitHub PR auto-verification quest (optional; Orange belt) ---
GITHUB_TOKEN=
# SERVER-ONLY. The quest id /api/attest signs for `github_pr` evidence (a merged PR). No
# default: while empty, GitHub PR attestations are rejected. Must differ from the ids above.
QUEST_GITHUB_ID=

# --- USDC test faucet (SERVER-ONLY, used by /api/faucet; TESTNET ONLY) ---
# Secret key of the USDC issuer; the faucet pays test USDC to wallets that hold the
# trustline. Never set this on mainnet — we never mint real USDC.
USDC_ISSUER_SECRET_KEY=

# --- Anchor off-ramp + proof-of-funding (reserved; SEP-24/SEP-12 wired at Black belt) ---
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=
NEXT_PUBLIC_ANCHOR_TRANSFER_SERVER=

# --- Analytics + monitoring (Green belt) ---
# Vercel Analytics + Speed Insights need NO keys — auto-enabled by <Analytics/> on Vercel.
# Basic page-view/visitor analytics works on any plan; custom events (lib/track) need Vercel Pro.

# --- Web Push / VAPID (Blue belt — "vouch claimed" push notification) ---
# Generate a key pair ONCE and keep them secret (private key is server-only):
#   npx web-push generate-vapid-keys
# or:
#   node -e "const wp=require('web-push');console.log(JSON.stringify(wp.generateVAPIDKeys()))"
#
# NEXT_PUBLIC_VAPID_PUBLIC_KEY  — baked into the client bundle (safe to expose)
# VAPID_PUBLIC_KEY              — same value; used server-side by web-push
# VAPID_PRIVATE_KEY             — SERVER-ONLY. Never commit, never expose to the client.
# VAPID_SUBJECT                 — identifies the push sender (mailto: or https: URL)
#
# Without these keys the push feature degrades gracefully:
#   • No opt-in banner is shown
#   • /api/push/notify returns {ok:true, skipped:true} instead of fanning out
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@alvinmunk.app

# Optional: Vercel KV / Upstash Redis for durable cross-region subscription storage.
# Without it the app uses an in-memory Map (fine for testnet; lost on cold-start).
# Set both vars (Vercel dashboard → Storage → connect an Upstash Redis store); setting only
# one logs an error and falls back to the in-memory Map.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
